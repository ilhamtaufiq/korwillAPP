---
import Shell from '../layouts/Shell.astro';
---
<Shell title="Pengaturan | KorwilAPP" menu="pengaturan">
<div id="error-message" class="mb-4 hidden rounded-lg border border-danger-line bg-danger-soft px-3 py-2 text-sm text-danger"></div>

  <div class="mb-4 flex flex-col gap-1">
    <h1 class="text-xl font-bold">Pengaturan</h1>
    <p class="text-sm text-ink3">Sumber data Lapming. Perbarui data dilakukan dari dashboard dengan satu tombol.</p>
  </div>

  <form id="form-sumber" class="flex max-w-2xl flex-col gap-4 rounded-lg border border-line bg-white p-4">
    <h2 class="font-semibold">Sumber data Lapming</h2>
    <div class="flex flex-col gap-1.5">
      <label class="text-sm font-semibold text-ink2" for="link-san">Link Google Sheets Sanimas</label>
      <input id="link-san" type="url" required class="h-11 rounded-lg border border-line px-4 text-sm focus:border-[1.5px] focus:border-primary focus:outline-none">
    </div>
    <div class="flex flex-col gap-1.5">
      <label class="text-sm font-semibold text-ink2" for="link-lpk">Link Google Sheets LPK</label>
      <input id="link-lpk" type="url" required class="h-11 rounded-lg border border-line px-4 text-sm focus:border-[1.5px] focus:border-primary focus:outline-none">
    </div>
    <div class="flex flex-col gap-1.5">
      <label class="text-sm font-semibold text-ink2" for="tahun-anggaran">Tahun anggaran pekerjaan baru</label>
      <input id="tahun-anggaran" type="number" min="2000" max="2100" required class="h-11 w-32 rounded-lg border border-line px-4 text-sm focus:border-[1.5px] focus:border-primary focus:outline-none">
    </div>
    <p class="text-xs text-ink3">Link harus dibagikan sebagai "Siapa saja yang memiliki link". Pekerjaan baru dari rekap Sanimas dibuat dengan tahun anggaran di atas.</p>
    <div>
      <button id="simpan" type="submit" class="h-11 rounded-lg bg-primary px-4 font-semibold text-white hover:bg-primary-hover disabled:opacity-50">Simpan</button>
    </div>
  </form>
<script is:inline>
const errorBox = document.getElementById('error-message');

(async () => {
  try {
    const user = await requireAuth();
    if (user.role !== 'admin') {
      window.location.replace('/');
      return;
    }
    const s = await api('GET', '/api/lapming/update');
    document.getElementById('link-san').value = s.link_san;
    document.getElementById('link-lpk').value = s.link_lpk;
    document.getElementById('tahun-anggaran').value = s.tahun_anggaran;
  } catch (err) {
    showError(errorBox, err.message);
  }
})();

document.getElementById('form-sumber').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('simpan');
  hideError(errorBox);
  setBusy(btn, true);
  try {
    await api('PUT', '/api/lapming/pengaturan', {
      link_san: document.getElementById('link-san').value.trim(),
      link_lpk: document.getElementById('link-lpk').value.trim(),
      tahun_anggaran: Number(document.getElementById('tahun-anggaran').value),
    });
    toast('Pengaturan disimpan.');
  } catch (err) {
    showError(errorBox, err.message);
  } finally {
    setBusy(btn, false);
  }
});
</script>
</Shell>
