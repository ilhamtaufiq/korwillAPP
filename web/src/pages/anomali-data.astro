---
import Shell from '../layouts/Shell.astro';
---
<Shell title="Cek Anomali Data | KorwilAPP" menu="anomali">
<div id="error-message" class="mb-4 hidden rounded-lg border border-danger-line bg-danger-soft px-3 py-2 text-sm text-danger"></div>

  <div class="mb-4 flex flex-col gap-1">
    <h1 class="text-xl font-bold">Cek Anomali Data</h1>
    <p class="text-sm text-ink3">Data Lapming yang janggal dari seluruh minggu: fisik turun, angka tidak menjumlah, fisik melebihi keuangan, dan lain-lain. Pilih korfas untuk mempersempit daftar.</p>
  </div>

  <section class="mb-4 grid gap-3 sm:grid-cols-3">
    <select id="filter-korfas" aria-label="Filter korfas" class="h-11 rounded-lg border border-line bg-white px-3 text-sm focus:border-[1.5px] focus:border-primary focus:outline-none">
      <option value="">Semua korfas</option>
    </select>
    <input id="filter-cari" type="search" aria-label="Cari anomali" placeholder="Cari pokmas atau kategori..."
      class="h-11 rounded-lg border border-line bg-white px-4 text-sm focus:border-[1.5px] focus:border-primary focus:outline-none sm:col-span-2">
  </section>

  <section id="ringkasan" class="mb-4 hidden grid gap-3 sm:grid-cols-2 xl:grid-cols-4"></section>
  <p id="info" class="mb-3 text-sm text-ink3"></p>

  <div class="overflow-x-auto rounded-lg border border-line bg-white">
    <table class="w-full min-w-[900px] text-left text-sm">
      <thead class="bg-muted text-xs font-semibold text-ink2">
        <tr>
          <th class="px-4 py-2">Korfas</th>
          <th class="px-4 py-2">Minggu</th>
          <th class="px-4 py-2">Sumber</th>
          <th class="px-4 py-2">Pokmas</th>
          <th class="px-4 py-2">Kategori</th>
          <th class="px-4 py-2">Keterangan</th>
        </tr>
      </thead>
      <tbody id="anomali-rows" class="divide-y divide-line"></tbody>
    </table>
  </div>
<script is:inline>
const errorBox = document.getElementById('error-message');
let semua = [];

function tampilkan() {
  const q = document.getElementById('filter-cari').value.trim().toLowerCase();
  const daftar = semua.filter((a) => !q ||
    [a.pokmas, a.kategori, a.keterangan, a.korfas].join(' ').toLowerCase().includes(q));
  const box = document.getElementById('anomali-rows');
  box.innerHTML = daftar.length
    ? daftar.map((a) => `
      <tr class="align-top hover:bg-muted">
        <td class="px-4 py-2 text-ink2">${esc(a.korfas)}</td>
        <td class="whitespace-nowrap px-4 py-2 font-semibold">${esc(a.sheet)}</td>
        <td class="px-4 py-2 text-ink2">${esc(a.sumber)}</td>
        <td class="px-4 py-2">${a.proyek_id ? `<a href="/detail-proyek.html?id=${a.proyek_id}" class="font-semibold text-primary hover:underline">${esc(a.pokmas)}</a>` : esc(a.pokmas)}</td>
        <td class="px-4 py-2 font-semibold text-warn">${esc(a.kategori)}</td>
        <td class="px-4 py-2 text-ink2">${esc(a.keterangan)}</td>
      </tr>`).join('')
    : `<tr><td colspan="6" class="px-4 py-6 text-center text-ink3">${semua.length
      ? 'Tidak ada anomali yang cocok dengan pencarian.'
      : 'Tidak ada anomali. Semua data Lapming lolos pemeriksaan.'}</td></tr>`;
  const info = document.getElementById('info');
  info.textContent = `Menampilkan ${daftar.length} dari ${semua.length} anomali` +
    (semua.length >= 5000 ? ' (dibatasi 5000 baris pertama; persempit dengan memilih korfas)' : '');
}

function ringkas() {
  const per = {};
  semua.forEach((a) => { per[a.kategori] = (per[a.kategori] || 0) + 1; });
  const kotak = document.getElementById('ringkasan');
  const kategori = Object.entries(per).sort((x, y) => y[1] - x[1]);
  kotak.classList.toggle('hidden', kategori.length === 0);
  kotak.innerHTML = kategori.map(([k, n]) => `
    <div class="rounded-lg border border-line bg-white p-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-ink3">${esc(k)}</p>
      <p class="mt-1 text-2xl font-bold">${n}</p>
    </div>`).join('');
}

async function muat() {
  const korfas = document.getElementById('filter-korfas').value;
  const q = korfas ? `?korfas=${encodeURIComponent(korfas)}` : '';
  document.getElementById('anomali-rows').innerHTML = skeletonRows(6, 6);
  const r = await api('GET', `/api/lapming/anomali${q}`);
  semua = r.items;
  ringkas();
  tampilkan();
}

(async () => {
  try {
    const user = await requireAuth();
    const info = await api('GET', '/api/lapming/info');
    const pilihan = document.getElementById('filter-korfas');
    (info.korfas || []).forEach((k) => {
      const o = document.createElement('option');
      o.value = k;
      o.textContent = k;
      pilihan.appendChild(o);
    });
    pilihan.addEventListener('change', () => muat().catch((e) => showError(errorBox, e.message)));
    document.getElementById('filter-cari').addEventListener('input', tampilkan);
    await muat();
  } catch (err) {
    showError(errorBox, err.message);
  }
})();
</script>
</Shell>
