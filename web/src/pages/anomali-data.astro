---
import Shell from '../layouts/Shell.astro';
---
<Shell title="Cek Anomali Data | KorwilAPP" menu="anomali">
<div id="error-message" class="mb-4 hidden rounded-lg border border-danger-line bg-danger-soft px-3 py-2 text-sm text-danger"></div>

  <div class="mb-4 flex flex-col gap-1">
    <h1 class="text-xl font-bold">Cek Anomali Data</h1>
    <p class="text-sm text-ink3">Data Lapming yang janggal dari seluruh minggu: fisik turun, angka tidak menjumlah, fisik melebihi keuangan, dan lain-lain. Korwil otomatis melihat data korwil sendiri.</p>
  </div>

  <section class="mb-4 grid gap-3 sm:grid-cols-3">
    <select id="filter-korfas" aria-label="Filter korwil" class="h-11 rounded-lg border border-line bg-white px-3 text-sm focus:border-[1.5px] focus:border-primary focus:outline-none">
      <option value="">Semua korwil</option>
    </select>
    <input id="filter-cari" type="search" aria-label="Cari anomali" placeholder="Cari pokmas atau kategori..."
      class="h-11 rounded-lg border border-line bg-white px-4 text-sm focus:border-[1.5px] focus:border-primary focus:outline-none sm:col-span-2">
  </section>

  <section id="ringkasan" class="mb-4 hidden grid gap-3 sm:grid-cols-2 xl:grid-cols-4"></section>
  <p id="info" class="mb-3 text-sm text-ink3"></p>

  <div class="overflow-x-auto rounded-lg border border-line bg-white">
    <table class="w-full min-w-[900px] text-left text-sm">
      <thead class="bg-muted text-xs font-semibold text-ink2">
        <tr>
          <th class="px-4 py-2">Korwil</th>
          <th class="px-4 py-2">Minggu</th>
          <th class="px-4 py-2">Sumber</th>
          <th class="px-4 py-2">Pokmas</th>
          <th class="px-4 py-2">Kategori</th>
          <th class="px-4 py-2">Keterangan</th>
        </tr>
      </thead>
      <tbody id="anomali-rows" class="divide-y divide-line"></tbody>
    </table>
  </div>

  <div class="mt-3 flex items-center justify-between gap-3">
    <span id="hal-info" class="text-sm text-ink3"></span>
    <div class="flex gap-2">
      <button id="hal-prev" type="button" class="h-11 rounded-lg border border-line px-4 text-sm font-semibold text-ink2 hover:bg-muted disabled:opacity-50">Sebelumnya</button>
      <button id="hal-next" type="button" class="h-11 rounded-lg border border-line px-4 text-sm font-semibold text-ink2 hover:bg-muted disabled:opacity-50">Berikutnya</button>
    </div>
  </div>
<script is:inline>
const errorBox = document.getElementById('error-message');
const PER_HALAMAN = 25;
let semua = [];
let halaman = 1;
let pilihanKorwilDiisi = false;

function daftarTersaring() {
  const q = document.getElementById('filter-cari').value.trim().toLowerCase();
  return semua.filter((a) => !q ||
    [a.pokmas, a.kategori, a.keterangan, a.korfas].join(' ').toLowerCase().includes(q));
}

function baris(a) {
  return `
      <tr class="align-top hover:bg-muted">
        <td class="px-4 py-2 text-ink2">${esc(a.korfas)}</td>
        <td class="whitespace-nowrap px-4 py-2 font-semibold">${esc(a.sheet)}</td>
        <td class="px-4 py-2 text-ink2">${esc(a.sumber)}</td>
        <td class="px-4 py-2">${a.proyek_id ? `<a href="/detail-proyek.html?id=${a.proyek_id}" class="font-semibold text-primary hover:underline">${esc(a.pokmas)}</a>` : esc(a.pokmas)}</td>
        <td class="px-4 py-2 font-semibold text-warn">${esc(a.kategori)}</td>
        <td class="px-4 py-2 text-ink2">${esc(a.keterangan)}</td>
      </tr>`;
}

function tampilkan() {
  const daftar = daftarTersaring();
  const totalHalaman = Math.max(1, Math.ceil(daftar.length / PER_HALAMAN));
  if (halaman > totalHalaman) halaman = totalHalaman;
  const awal = (halaman - 1) * PER_HALAMAN;
  const potongan = daftar.slice(awal, awal + PER_HALAMAN);
  document.getElementById('anomali-rows').innerHTML = potongan.length
    ? potongan.map(baris).join('')
    : `<tr><td colspan="6" class="px-4 py-6 text-center text-ink3">${semua.length
      ? 'Tidak ada anomali yang cocok dengan pencarian.'
      : 'Tidak ada anomali. Semua data Lapming lolos pemeriksaan.'}</td></tr>`;
  document.getElementById('info').textContent = `Total ${daftar.length} anomali` +
    (semua.length >= 5000 ? ' (dibatasi 5000 baris pertama; persempit dengan memilih korwil)' : '');
  document.getElementById('hal-info').textContent = daftar.length
    ? `Halaman ${halaman} dari ${totalHalaman} • ${awal + 1}–${awal + potongan.length} dari ${daftar.length}`
    : '';
  document.getElementById('hal-prev').disabled = halaman <= 1;
  document.getElementById('hal-next').disabled = halaman >= totalHalaman;
}

function ringkas() {
  const per = {};
  semua.forEach((a) => { per[a.kategori] = (per[a.kategori] || 0) + 1; });
  const kotak = document.getElementById('ringkasan');
  const kategori = Object.entries(per).sort((x, y) => y[1] - x[1]);
  kotak.classList.toggle('hidden', kategori.length === 0);
  kotak.innerHTML = kategori.map(([k, n]) => `
    <div class="rounded-lg border border-line bg-white p-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-ink3">${esc(k)}</p>
      <p class="mt-1 text-2xl font-bold">${n}</p>
    </div>`).join('');
}

// Pilihan korwil diisi dari server. Akun korwil hanya mendapat korwilnya sendiri, dan itu terpilih otomatis.
function isiPilihanKorwil(r) {
  const pilihan = document.getElementById('filter-korfas');
  const opsi = r.korfas.map((k) => `<option value="${esc(k)}">${esc(k)}</option>`).join('');
  pilihan.innerHTML = (r.bisa_semua ? '<option value="">Semua korwil</option>' : '') + opsi;
  if (r.korfas.length) pilihan.value = r.bisa_semua ? '' : r.korfas[0];
  pilihanKorwilDiisi = true;
}

async function muat() {
  const korfas = document.getElementById('filter-korfas').value;
  const q = korfas ? `?korfas=${encodeURIComponent(korfas)}` : '';
  document.getElementById('anomali-rows').innerHTML = skeletonRows(6, 6);
  const r = await api('GET', `/api/lapming/anomali${q}`);
  if (!pilihanKorwilDiisi) isiPilihanKorwil(r);
  if (!r.bisa_semua && !r.korfas.length) {
    document.getElementById('anomali-rows').innerHTML =
      '<tr><td colspan="6" class="px-4 py-6 text-center text-ink3">Akun korwil Anda belum cocok dengan nama korwil di data Lapming. Hubungi admin.</td></tr>';
    document.getElementById('info').textContent = '';
    document.getElementById('hal-info').textContent = '';
    document.getElementById('hal-prev').disabled = true;
    document.getElementById('hal-next').disabled = true;
    semua = [];
    ringkas();
    return;
  }
  semua = r.items;
  halaman = 1;
  ringkas();
  tampilkan();
}

const jalan = () => muat().catch((err) => showError(errorBox, err.message));

document.getElementById('filter-korfas').addEventListener('change', jalan);
document.getElementById('filter-cari').addEventListener('input', () => { halaman = 1; tampilkan(); });
document.getElementById('hal-prev').addEventListener('click', () => { halaman -= 1; tampilkan(); });
document.getElementById('hal-next').addEventListener('click', () => { halaman += 1; tampilkan(); });

(async () => {
  try {
    await requireAuth();
    await jalan();
  } catch (err) {
    showError(errorBox, err.message);
  }
})();
</script>
</Shell>
