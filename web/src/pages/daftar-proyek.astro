---
import Shell from '../layouts/Shell.astro';
---
<Shell title="Daftar Pekerjaan | KorwilAPP" menu="daftar">
<div class="mb-4 flex items-center justify-between gap-3">
    <h1 class="text-xl font-bold">Daftar Pekerjaan</h1>
    <a id="new-project" href="/tambah-proyek.html" hidden
      class="inline-flex h-11 items-center rounded-lg bg-primary px-4 font-semibold text-white hover:bg-primary-hover">Pekerjaan baru</a>
  </div>

  <div id="error-message" class="mb-4 hidden rounded-lg border border-danger-line bg-danger-soft px-3 py-2 text-sm text-danger"></div>
  <section id="import-section" hidden class="mb-6 rounded-lg border border-line bg-white p-4">
    <h2 class="font-semibold">Impor Data Pekerjaan dari Rekap Lapming</h2>
    <p class="mt-1 text-sm text-ink3">Pilih file rekap Lapming (.xlsx). Setiap pokmas dibuat sebagai satu pekerjaan. Pokmas yang sudah ada untuk kegiatan dan tahun yang sama dilewati.</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-3">
      <div class="flex flex-col gap-1.5">
        <label class="text-sm font-semibold text-ink2" for="imp-kegiatan">Kegiatan</label>
        <input id="imp-kegiatan" value="Sanimas" class="h-11 rounded-lg border border-line px-4 focus:border-[1.5px] focus:border-primary focus:outline-none">
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-sm font-semibold text-ink2" for="imp-tahun">Tahun anggaran</label>
        <input id="imp-tahun" type="number" value="2026" class="h-11 rounded-lg border border-line px-4 focus:border-[1.5px] focus:border-primary focus:outline-none">
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-sm font-semibold text-ink2" for="imp-file">File .xlsx</label>
        <input id="imp-file" type="file" accept=".xlsx" class="h-11 text-sm">
      </div>
    </div>
    <button id="imp-go" type="button" class="mt-4 h-11 rounded-lg bg-primary px-4 font-semibold text-white hover:bg-primary-hover">Impor</button>
    <p id="imp-result" class="mt-3 whitespace-pre-line text-sm text-ink2"></p>
  </section>

  <section class="mb-4 grid gap-3 sm:grid-cols-3">
    <input id="filter-search" type="search" placeholder="Cari pekerjaan, pokmas, desa, atau kode..."
      class="h-11 rounded-lg border border-line bg-white px-4 text-sm focus:border-[1.5px] focus:border-primary focus:outline-none sm:col-span-1">
    <select id="filter-kabupaten" class="h-11 rounded-lg border border-line bg-white px-3 text-sm focus:border-[1.5px] focus:border-primary focus:outline-none">
      <option value="">Semua kabupaten</option>
    </select>
    <select id="filter-kegiatan" class="h-11 rounded-lg border border-line bg-white px-3 text-sm focus:border-[1.5px] focus:border-primary focus:outline-none">
      <option value="">Semua kegiatan</option>
    </select>
  </section>
  <p id="list-count" class="mb-3 text-sm text-ink3"></p>

  <div class="overflow-x-auto rounded-lg border border-line bg-white">
    <table class="w-full min-w-[1000px] text-left text-sm">
      <thead class="bg-muted text-xs font-semibold text-ink2">
        <tr>
          <th class="px-4 py-2">Pekerjaan</th>
          <th class="px-4 py-2">Pokmas</th>
          <th class="px-4 py-2">Lokasi</th>
          <th class="px-4 py-2">Kegiatan</th>
          <th class="px-4 py-2">Korwil</th>
          <th class="px-4 py-2">FM Teknik</th>
          <th class="px-4 py-2">FM Pemberdayaan</th>
          <th class="px-4 py-2 text-right">Target KK</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody id="project-rows" class="divide-y divide-line"></tbody>
    </table>
  </div>
  <p id="empty-state" class="hidden rounded-lg border border-line bg-white p-6 text-center text-sm text-ink3">
    Belum ada pekerjaan yang bisa Anda akses.
  </p>
<script is:inline>
const errorBox = document.getElementById('error-message');

let allProjects = [];

function projectRow(p) {
  const target = p.target_sasaran > 0 ? Number(p.target_sasaran).toLocaleString('id-ID') : '<span class="text-ink3">-</span>';
  const kode = p.kode_proyek ? `<p class="text-xs text-ink3">${esc(p.kode_proyek)}</p>` : '';
  return `
    <tr class="align-top hover:bg-muted">
      <td class="px-4 py-3">
        <a href="/detail-proyek.html?id=${p.id}" class="font-semibold text-ink hover:text-primary">${esc(p.judul)}</a>
        ${kode}
      </td>
      <td class="px-4 py-3 text-ink2">${esc(p.pokmas)}</td>
      <td class="px-4 py-3 text-ink2">Desa ${esc(p.desa)}, Kec. ${esc(p.kecamatan)}, ${esc(p.kabupaten)}</td>
      <td class="px-4 py-3 text-ink2">${esc(p.kegiatan)}<p class="text-xs text-ink3">TA ${p.tahun}</p></td>
      <td class="px-4 py-3 text-ink2">${p.korwil_nama ? esc(p.korwil_nama) : '<span class="text-ink3">-</span>'}</td>
      <td class="px-4 py-3 text-ink2">${p.tfl_nama ? esc(p.tfl_nama) : '<span class="text-ink3">-</span>'}</td>
      <td class="px-4 py-3 text-ink2">${p.fm_pemberdayaan_nama ? esc(p.fm_pemberdayaan_nama) : '<span class="text-ink3">-</span>'}</td>
      <td class="px-4 py-3 text-right font-semibold text-ink2">${target}</td>
      <td class="px-4 py-3 text-right"><a href="/detail-proyek.html?id=${p.id}" class="font-semibold text-primary hover:underline">Buka</a></td>
    </tr>`;
}

function fillSelect(id, label, values) {
  const el = document.getElementById(id);
  const current = el.value;
  el.innerHTML = `<option value="">${label}</option>` +
    values.map((v) => `<option value="${esc(v)}">${esc(v)}</option>`).join('');
  el.value = values.includes(current) ? current : '';
}

// Menerapkan pencarian dan filter ke daftar pekerjaan yang sudah dimuat.
function renderList() {
  const q = document.getElementById('filter-search').value.trim().toLowerCase();
  const kab = document.getElementById('filter-kabupaten').value;
  const keg = document.getElementById('filter-kegiatan').value;

  const list = allProjects.filter((p) =>
    (!kab || p.kabupaten === kab) &&
    (!keg || p.kegiatan === keg) &&
    (!q || [p.judul, p.pokmas, p.desa, p.kecamatan, p.kabupaten, p.kode_proyek || '']
      .join(' ').toLowerCase().includes(q)));

  const box = document.getElementById('project-rows');
  if (list.length) {
    box.innerHTML = list.map(projectRow).join('');
  } else if (allProjects.length) {
    box.innerHTML = '<tr><td colspan="9" class="px-4 py-6 text-center text-ink3">Tidak ada pekerjaan yang cocok dengan pencarian atau filter.</td></tr>';
  } else {
    box.innerHTML = '';
  }

  document.getElementById('list-count').textContent =
    `Menampilkan ${list.length} dari ${allProjects.length} pekerjaan`;
  document.getElementById('empty-state').classList.toggle('hidden', allProjects.length > 0);
}

async function loadProjects() {
  document.getElementById('project-rows').innerHTML = skeletonRows(9, 6);
  allProjects = await api('GET', '/api/projects');
  fillSelect('filter-kabupaten', 'Semua kabupaten', [...new Set(allProjects.map((p) => p.kabupaten))].sort());
  fillSelect('filter-kegiatan', 'Semua kegiatan', [...new Set(allProjects.map((p) => p.kegiatan))].sort());
  renderList();
}

document.getElementById('filter-search').addEventListener('input', renderList);
document.getElementById('filter-kabupaten').addEventListener('change', renderList);
document.getElementById('filter-kegiatan').addEventListener('change', renderList);

(async () => {
  try {
    const user = await requireAuth();
    document.getElementById('user-name').textContent = `${user.username} • ${user.role === 'admin' ? 'Admin' : 'FM'}`;
    if (user.role === 'admin') {
      document.getElementById('new-project').hidden = false;
      document.getElementById('import-section').hidden = false;
    }

    await loadProjects();
  } catch (err) {
    showError(errorBox, err.message);
  }
})();

document.getElementById('imp-go').addEventListener('click', async () => {
  const resultBox = document.getElementById('imp-result');
  const file = document.getElementById('imp-file').files[0];
  if (!file) {
    resultBox.textContent = 'Pilih file .xlsx dulu.';
    return;
  }
  const params = new URLSearchParams({
    kegiatan: document.getElementById('imp-kegiatan').value.trim(),
    tahun: document.getElementById('imp-tahun').value,
  });
  resultBox.textContent = 'Mengimpor... file besar bisa butuh beberapa detik.';
  try {
    const res = await fetch(`/api/projects/import-xlsx?${params}`, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' },
      body: file,
    });
    const data = await res.json().catch(() => null);
    if (!res.ok) throw new Error((data && data.error) || 'Impor gagal.');
    const akun = (data.akun_baru || [])
      .map((a) => `${a.nama}: username ${a.username}, password ${a.password} (${a.role})`)
      .join('\n');
    resultBox.textContent =
      `Ditambahkan ${data.ditambahkan}, sudah ada ${data.sudah_ada}, tidak valid ${data.tidak_valid} (dari ${data.sheet_dibaca} sheet).` +
      (akun ? `\n\nAkun baru (${data.akun_baru.length}):\n${akun}` : '');
    await loadProjects();
  } catch (err) {
    resultBox.textContent = err.message;
  }
});
</script>
</Shell>
